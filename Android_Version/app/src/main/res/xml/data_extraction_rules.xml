<?xml version="1.0" encoding="utf-8"?>
<!-- 排除含登录凭据（login_name/ses_id）的 DataStore 文件，禁止云备份与设备迁移读取 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/hgej_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/hgej_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
