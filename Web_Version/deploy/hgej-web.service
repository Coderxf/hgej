[Unit]
Description=Hgej Web (杭工助手网页版)
After=network.target

[Service]
Type=simple
# 按实际部署路径与用户修改
User=root
WorkingDirectory=/opt/hgej-web/server
# 口令文件路径（默认同目录 passcodes.json），可用环境变量覆盖：
# Environment=PASSCODES_FILE=/opt/hgej-web/server/passcodes.json
# Environment=PORT=8090
ExecStart=/opt/hgej-web/server/venv/bin/python app.py
Restart=always
RestartSec=3
# 加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
